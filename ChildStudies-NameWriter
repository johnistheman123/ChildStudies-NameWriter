!doctype html>
<html lang="en">
<head>
	<meta charset="utf-8">
	<meta name="viewport" content="width=device-width, initial-scale=1, maximum-scale=1, user-scalable=no">
	<meta name="theme-color" content="#fff8ed">
	<title>My Name Writer</title>
	<style>
		:root { --ink:#35445d; --pink:#ff8ca3; --yellow:#ffcf5a; --blue:#79c9e8; --paper:#fffdf9; }
		* { box-sizing:border-box; }
		body { margin:0; min-height:100vh; color:var(--ink); background:#fff8ed; font-family:"Trebuchet MS",Arial,sans-serif; }
		button { font:inherit; touch-action:manipulation; }
		.app { max-width:1100px; margin:auto; padding:clamp(14px,3vw,30px); }
		header { text-align:center; margin-bottom:18px; }
		h1 { margin:0; color:#f16e89; font-size:clamp(2rem,6vw,3.5rem); letter-spacing:.02em; }
		header p { margin:6px 0 0; font-size:clamp(1rem,2.7vw,1.25rem); }
		.panel { background:var(--paper); border:3px solid #f5e8d7; border-radius:24px; padding:clamp(14px,3vw,24px); box-shadow:0 6px 0 #f1e2cf; }
		.choose-title { margin:0 0 12px; font-size:1.15rem; }
		.names { display:grid; grid-template-columns:repeat(auto-fit,minmax(94px,1fr)); gap:9px; }
		.name-button { min-height:48px; border:2px solid #dcecf2; border-radius:15px; background:#f4fbfd; color:var(--ink); font-weight:700; font-size:1rem; cursor:pointer; }
		.name-button:hover { transform:translateY(-1px); }
		.name-button[aria-pressed="true"] { background:#fff0f3; border-color:var(--pink); color:#c94c68; }
		.practice { margin-top:20px; }
		.prompt { text-align:center; margin:0 0 10px; font-size:clamp(1.25rem,4vw,2rem); }
		.prompt strong { color:#e96783; }
		.canvas-wrap { overflow:hidden; border:3px solid #d8edf2; border-radius:20px; background:white; }
		canvas { display:block; width:100%; height:clamp(190px,38vw,320px); touch-action:none; cursor:crosshair; }
		.hint { margin:9px 0 14px; text-align:center; color:#6f7d8f; font-size:.96rem; }
		.actions { display:flex; justify-content:center; flex-wrap:wrap; gap:12px; }
		.action { min-height:52px; padding:10px 22px; border:0; border-radius:16px; font-weight:800; font-size:1.05rem; cursor:pointer; box-shadow:0 4px rgba(0,0,0,.1); }
		.clear { background:#e9f4fb; color:#365a72; }
		.next { background:var(--yellow); color:#59440b; }
		.message { min-height:1.5em; margin:13px 0 0; text-align:center; color:#388461; font-weight:700; }
		@media (max-width:480px) { .names { grid-template-columns:repeat(3,1fr); gap:7px; } .name-button { font-size:.92rem; } }
	</style>
</head>
<body>
	<main class="app">
		<header>
			<h1>My Name Writer ✨</h1>
			<p>Pick your name, then trace it with your finger!</p>
		</header>
		<section class="panel" aria-label="Name writing activity">
			<h2 class="choose-title">Who are you writing today?</h2>
			<div class="names" id="names" aria-label="Choose a name"></div>
			<div class="practice">
				<p class="prompt">Trace <strong id="chosen-name">Adriel</strong></p>
				<div class="canvas-wrap"><canvas id="writing-board" aria-label="Writing area. Trace the light letters with your finger."></canvas></div>
				<p class="hint">Start at the beginning of the light letters. You can draw with your finger or a mouse.</p>
				<div class="actions">
					<button class="action clear" id="clear-button" type="button">↻ Start again</button>
					<button class="action next" id="next-button" type="button">Next name →</button>
				</div>
				<p class="message" id="message" aria-live="polite"></p>
			</div>
		</section>
	</main>
	<script>
		(() => {
			const names = ['Adriel','Alma','Amyla','Anaya','Asher','Ayana','Ayuta','Christopher','Cody','Declan','Frederick','Ivaan','Mia','Parnika','Raya','Tayston','Vritti'];
			const picker = document.getElementById('names');
			const canvas = document.getElementById('writing-board');
			const ctx = canvas.getContext('2d');
			const label = document.getElementById('chosen-name');
			const message = document.getElementById('message');
			let selected = 0, strokes = [], activeStroke = null;

			names.forEach((name, index) => {
				const button = document.createElement('button');
				button.type = 'button'; button.className = 'name-button'; button.textContent = name;
				button.setAttribute('aria-pressed', index === selected ? 'true' : 'false');
				button.addEventListener('click', () => selectName(index));
				picker.appendChild(button);
			});

			function selectName(index) {
				selected = (index + names.length) % names.length;
				label.textContent = names[selected]; message.textContent = '';
				[...picker.children].forEach((button, i) => button.setAttribute('aria-pressed', i === selected ? 'true' : 'false'));
				strokes = []; resizeBoard();
			}
			function resizeBoard() {
				const rect = canvas.getBoundingClientRect();
				const ratio = window.devicePixelRatio || 1;
				canvas.width = Math.round(rect.width * ratio); canvas.height = Math.round(rect.height * ratio);
				ctx.setTransform(ratio, 0, 0, ratio, 0, 0);
				drawBoard();
			}
			function drawBoard() {
				const w = canvas.clientWidth, h = canvas.clientHeight;
				ctx.clearRect(0, 0, w, h);
				ctx.fillStyle = '#fff'; ctx.fillRect(0, 0, w, h);
				ctx.strokeStyle = '#e9f1f3'; ctx.lineWidth = 1;
				for (let y = h * .25; y < h; y += h * .25) { ctx.beginPath(); ctx.moveTo(0,y); ctx.lineTo(w,y); ctx.stroke(); }
				const name = names[selected];
				let size = Math.min(h * .66, (w - 30) / name.length * 1.65);
				ctx.font = `700 ${size}px "Trebuchet MS", Arial, sans-serif`;
				while (ctx.measureText(name).width > w - 30 && size > 20) { size -= 2; ctx.font = `700 ${size}px "Trebuchet MS", Arial, sans-serif`; }
				ctx.textAlign = 'center'; ctx.textBaseline = 'middle';
				ctx.fillStyle = '#d7e1e6'; ctx.fillText(name, w / 2, h / 2);
				strokes.forEach(stroke => drawStroke(stroke));
			}
			function drawStroke(points) {
				if (!points.length) return;
				ctx.beginPath(); ctx.moveTo(points[0].x, points[0].y);
				for (let i = 1; i < points.length; i++) ctx.lineTo(points[i].x, points[i].y);
				ctx.strokeStyle = '#f16e89'; ctx.lineWidth = Math.max(5, canvas.clientHeight * .025);
				ctx.lineCap = 'round'; ctx.lineJoin = 'round'; ctx.stroke();
			}
			function pointFromEvent(event) {
				const rect = canvas.getBoundingClientRect();
				return { x:event.clientX - rect.left, y:event.clientY - rect.top };
			}
			canvas.addEventListener('pointerdown', event => {
				event.preventDefault(); canvas.setPointerCapture(event.pointerId);
				activeStroke = [pointFromEvent(event)]; strokes.push(activeStroke); message.textContent = '';
				drawBoard();
			});
			canvas.addEventListener('pointermove', event => {
				if (!activeStroke) return;
				activeStroke.push(pointFromEvent(event)); drawBoard();
			});
			function finishStroke() {
				if (!activeStroke) return;
				activeStroke = null;
				if (strokes.length >= 2 || strokes.reduce((sum, stroke) => sum + stroke.length, 0) > 18) message.textContent = `Lovely practicing, ${names[selected]}! ⭐`;
			}
			canvas.addEventListener('pointerup', finishStroke);
			canvas.addEventListener('pointercancel', finishStroke);
			document.getElementById('clear-button').addEventListener('click', () => { strokes = []; message.textContent = ''; drawBoard(); });
			document.getElementById('next-button').addEventListener('click', () => selectName(selected + 1));
			window.addEventListener('resize', resizeBoard);
			resizeBoard();
		})();
	</script>
</body>
</html>
